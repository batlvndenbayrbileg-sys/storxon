# Сайтын бүтэн хаяг (QPay callback, имэйлийн холбоос)
NEXT_PUBLIC_SITE_URL=https://storxon.online

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# НУУЦ: зөвхөн server. NEXT_PUBLIC_ гэж хэзээ ч эхлүүлэхгүй.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Botxon Gateway (төлбөр) — botxon.chat → Gateway → merchant-ийн API key
# QPay username/password/invoice code ХЭРЭГГҮЙ. Зөвхөн доорх хоёр түлхүүр.
BOTXON_API_KEY=gw_live_xxx
BOTXON_WEBHOOK_SECRET=
# BOTXON_BASE_URL=https://botxon.chat/api/gateway/v1

# Урьдчилсан үнэ (true/false)
PRESALE=true

# Админ самбар (/admin) нээгдэх имэйлүүд, таслалаар. Энэ хаягаар Supabase-д данс үүсгэнэ.
ADMIN_EMAILS=storxon@gmail.com
