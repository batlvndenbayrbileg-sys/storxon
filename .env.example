# Сайтын бүтэн хаяг (QPay callback, имэйлийн холбоос)
NEXT_PUBLIC_SITE_URL=https://storxon.online

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# НУУЦ: зөвхөн server. NEXT_PUBLIC_ гэж хэзээ ч эхлүүлэхгүй.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# QPay merchant (НУУЦ)
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=

# Урьдчилсан үнэ (true/false)
PRESALE=true
